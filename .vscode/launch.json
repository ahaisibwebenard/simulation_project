{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Bunyonyi simulation in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Bunyonyi local server"
    },
    {
      "name": "Debug the local Node server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
