{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Bunyonyi local server",
      "type": "process",
      "command": "node",
      "args": ["scripts/dev-server.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "bunyonyi-server",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting Bunyonyi development server",
          "endsPattern": "^Bunyonyi development server ready at"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "Run Bunyonyi tests",
      "type": "process",
      "command": "node",
      "args": ["--test", "tests/model.test.js", "tests/server.test.js"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
